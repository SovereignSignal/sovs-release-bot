TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
CHECK_INTERVAL=30
WATCH_PACKAGES=openclaw,hermes-agent,codex,claude-code

# Prereleases: unset uses package defaults (OpenClaw on — their latest work
# ships as betas; others off). Set to all / none / a CSV of package keys.
# WATCH_PRERELEASES=openclaw

# State (version baselines). On Railway, mount a volume at /data and use these
# paths so baselines survive redeploys. For systemd / self-hosting, the /opt
# paths below are the defaults used by setup.sh.
STATE_FILE=/opt/sovs-release-bot/data/last-version.txt
STATE_DIR=/opt/sovs-release-bot/data
# Railway volume alternative:
# STATE_DIR=/data
# STATE_FILE=/data/last-version.txt

# Ollama "What's new" summaries (optional). Set OLLAMA_API_KEY to enable; leave
# blank to fall back to the parsed changelog. Key from ollama.com -> Keys.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
# Code defaults when unset. A value already set on the service overrides these.
OLLAMA_MODEL=deepseek-v4.1-flash
# One retry if the primary times out, errors, returns an empty reply, or
# includes a number that is not in the release text. Empty skips the retry.
OLLAMA_MODEL_FALLBACK=glm-5.3-flash
SUMMARY_TIMEOUT=30

# Optional AI Wire registry. Off unless AI_WIRE_ENABLED is true, 1, yes, or on.
# A push runs only after Telegram accepts an alert, times out at 5s, retries
# once, and a failure does not affect the alert.
AI_WIRE_ENABLED=false
AI_WIRE_URL=
AI_WIRE_INGEST_TOKEN=
